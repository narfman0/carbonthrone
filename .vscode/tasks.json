{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cargo",
			"command": "build",
			"problemMatcher": [
				"$rustc"
			],
			"args": [
				"-p",
				"carbonthrone-gui"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "rust: cargo build carbonthrone-gui"
		},
		{
			"type": "cargo",
			"command": "run",
			"args": [
				"--bin",
				"carbonthrone_gui"
			],
			"dependsOn": "rust: cargo build carbonthrone-gui",
			"problemMatcher": [
				"$rustc"
			],
			"label": "rust: cargo run carbonthrone_gui"
		},
		{
			"type": "cargo",
			"command": "test",
			"args": [
				"--jobs",
				"2"
			],
			"problemMatcher": [
				"$rustc"
			],
			"label": "rust: cargo test"
		}
	]
}